# Copy this to a real .env file for local runs or to the Render service environment variables.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TIMEOUT_SECONDS=8

# Local development values (single unified backend)
PORT=8000

# Render deployment: single web service (rootDir: backend).
# PORT is automatically injected by Render; do NOT set it manually in the Render UI.
# Frontend on Vercel should set VITE_API_BASE_URL=https://yojana-sathi-api.onrender.com
# (replace with your actual Render URL) or update frontend/vercel.json rewrites.

# Authority desk logins (3 tiers). All 5 citizen departments share the L1 mail.
L1_NODAL_EMAIL=kumardp2707@gmail.com
L1_PASSWORD=nodal123
L2_COLLECTOR_EMAIL=manilal2357@gmail.com
L2_PASSWORD=collector123
L3_CMO_EMAIL=0585mt241001@pimrbhopal.ac.in
L3_PASSWORD=cmo123

# ---- Real outbound email (free, no credit card) ----
# Option A - Brevo API (300/day free): sign up at brevo.com, copy API key.
# BREVO_API_KEY=
# BREVO_SENDER=noreply@mp.gov.in
# BREVO_SENDER_NAME=MP CM Online
# Option B - Gmail SMTP (free ~500/day): enable 2FA on the sender Gmail,
# create an App Password (Google Account > Security > App passwords),
# then fill these three lines. Do NOT use the normal login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Ticket database (Supabase, free tier, no credit card) ----
# 1. Create a free project at supabase.com, open SQL Editor,
#    paste backend/supabase_schema.sql and Run.
# 2. Copy Project URL + service_role key (Server-side only, never public).
SUPABASE_URL=
SUPABASE_KEY=
# SUPABASE_TABLE=grievances
SUPABASE_STORAGE_BUCKET=evidence

# ---- Helpdesk AI chat (OpenRouter, server-side only) ----
# Set OPENROUTER_API_KEY in the backend environment (never in frontend code).
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
